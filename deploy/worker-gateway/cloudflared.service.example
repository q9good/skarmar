[Unit]
Description=Skarma Cloudflare Workers VPC connector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/test -s %h/.config/skarma/cloudflared-token
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --edge-ip-version 4 --protocol quic --metrics 127.0.0.1:20251 --loglevel info run --token-file %h/.config/skarma/cloudflared-token
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
