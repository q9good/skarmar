# The browser and API share this HTTPS origin. No path or trailing slash needed.
# Private first: https://device.your-tailnet.ts.net (Tailscale Serve).
# Later, use your Cloudflare hostname and keep the same app and data volume.
SKARMA_PUBLIC_URL=https://app.example.com
SKARMA_PRODUCTION=1
SKARMA_SPACE=family
# Host port is exposed only on loopback, never to the LAN or Internet.
SKARMA_LOCAL_PORT=3001
